<script>
(function () {
    'use strict';
    var yearEl = document.getElementById('copyright-year');
    if (yearEl) { yearEl.textContent = new Date().getFullYear(); }

    var LEVELS=[0.75,0.9,1,1.1,1.25,1.5,1.75,2], MIN_INDEX=0, MAX_INDEX=LEVELS.length-1, DEFAULT_INDEX=2;
    var STORE_KEY_SIZE='ch5-font-scale-index', STORE_KEY_THEME='ch5-theme';
    var btnIncrease=document.getElementById('font-increase'), btnDecrease=document.getElementById('font-decrease'), btnReset=document.getElementById('font-reset');
    var display=document.getElementById('font-level-display'), root=document.documentElement;

    function clamp(n,lo,hi){return Math.min(hi,Math.max(lo,n));}
    function getStoredIndex(){try{var raw=window.localStorage.getItem(STORE_KEY_SIZE);if(raw===null)return DEFAULT_INDEX;var n=parseInt(raw,10);return isNaN(n)?DEFAULT_INDEX:clamp(n,MIN_INDEX,MAX_INDEX);}catch(e){return DEFAULT_INDEX;}}
    function applyScale(index,announce){index=clamp(index,MIN_INDEX,MAX_INDEX);var scale=LEVELS[index];root.style.setProperty('--font-scale',String(scale));document.body.style.fontSize=(scale*100)+'%';display.textContent=Math.round(scale*100)+'%';btnDecrease.disabled=(index===MIN_INDEX);btnIncrease.disabled=(index===MAX_INDEX);btnDecrease.setAttribute('aria-disabled',String(index===MIN_INDEX));btnIncrease.setAttribute('aria-disabled',String(index===MAX_INDEX));try{window.localStorage.setItem(STORE_KEY_SIZE,String(index));}catch(e){}if(announce){display.textContent=Math.round(scale*100)+'% text size';}}

    var currentIndex=getStoredIndex();applyScale(currentIndex,false);
    btnIncrease.addEventListener('click',function(){currentIndex=clamp(currentIndex+1,MIN_INDEX,MAX_INDEX);applyScale(currentIndex,true);});
    btnDecrease.addEventListener('click',function(){currentIndex=clamp(currentIndex-1,MIN_INDEX,MAX_INDEX);applyScale(currentIndex,true);});
    btnReset.addEventListener('click',function(){currentIndex=DEFAULT_INDEX;applyScale(currentIndex,true);});

    document.addEventListener('keydown',function(evt){if(!(evt.ctrlKey||evt.metaKey))return;if(evt.key==='+'||evt.key==='='){evt.preventDefault();currentIndex=clamp(currentIndex+1,MIN_INDEX,MAX_INDEX);applyScale(currentIndex,true);}else if(evt.key==='-'||evt.key==='_'){evt.preventDefault();currentIndex=clamp(currentIndex-1,MIN_INDEX,MAX_INDEX);applyScale(currentIndex,true);}else if(evt.key==='0'){evt.preventDefault();currentIndex=DEFAULT_INDEX;applyScale(currentIndex,true);}});

    var themeToggle=document.getElementById('theme-toggle');
    function getPreferredTheme(){try{var stored=window.localStorage.getItem(STORE_KEY_THEME);if(stored==='dark'||stored==='light')return stored;}catch(e){}if(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)return 'dark';return 'light';}
    function applyTheme(theme,persist){if(theme==='dark'){root.setAttribute('data-theme','dark');themeToggle.setAttribute('aria-pressed','true');themeToggle.textContent='☀️ Light Mode';themeToggle.setAttribute('aria-label','Switch to light mode');}else{root.removeAttribute('data-theme');themeToggle.setAttribute('aria-pressed','false');themeToggle.textContent='🌙 Dark Mode';themeToggle.setAttribute('aria-label','Switch to dark mode');}if(persist){try{window.localStorage.setItem(STORE_KEY_THEME,theme);}catch(e){}}}

    var currentTheme=getPreferredTheme();applyTheme(currentTheme,false);
    themeToggle.addEventListener('click',function(){currentTheme=(currentTheme==='dark')?'light':'dark';applyTheme(currentTheme,true);});

    if(window.matchMedia){var mq=window.matchMedia('(prefers-color-scheme: dark)');var onChange=function(e){var stored=null;try{stored=window.localStorage.getItem(STORE_KEY_THEME);}catch(err){stored=null;}if(stored!=='dark'&&stored!=='light'){currentTheme=e.matches?'dark':'light';applyTheme(currentTheme,false);}};if(mq.addEventListener){mq.addEventListener('change',onChange);}else if(mq.addListener){mq.addListener(onChange);}}
})();
</script>

